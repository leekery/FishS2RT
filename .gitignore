/native/audio.cpp/external/sentencepiece/data/*.txt

# Fish-only native snapshot. Shared framework, ggml CPU/CUDA code and the
# small built-in VAD sources remain public because the worker builds them.
/native/audio.cpp/src/community_models/
/native/audio.cpp/include/engine/community_models/
/native/audio.cpp/src/models/*
!/native/audio.cpp/src/models/fish_audio/
!/native/audio.cpp/src/models/controlfoley/
!/native/audio.cpp/src/models/silero_vad/
!/native/audio.cpp/src/models/marblenet_vad/
/native/audio.cpp/include/engine/models/*
!/native/audio.cpp/include/engine/models/fish_audio/
!/native/audio.cpp/include/engine/models/controlfoley/
!/native/audio.cpp/include/engine/models/silero_vad/
!/native/audio.cpp/include/engine/models/marblenet_vad/
/native/audio.cpp/model_specs/*
!/native/audio.cpp/model_specs/fish_audio.json
/native/audio.cpp/tools/
/native/audio.cpp/examples/
/native/audio.cpp/tests/
/native/audio.cpp/app/gguf/
/native/audio.cpp/app/model_manager/
/native/audio.cpp/app/server/*
!/native/audio.cpp/app/server/server_frontends.cmake
/native/audio.cpp/scripts/package_windows_prebuilt.ps1
